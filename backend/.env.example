# Django
SECRET_KEY=django-insecure-change-this-value-before-production
DJANGO_SETTINGS_MODULE=config.django.local
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TIME_ZONE=UTC
LANGUAGE_CODE=en-us
SQLITE_DB_PATH=db.sqlite3
LOG_LEVEL=INFO

# Azure OpenAI - configured now; consumed by the LLM integration module.
# Use your Azure resource endpoint and the exact deployment name from Azure.
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE-NAME.openai.azure.com
AZURE_OPENAI_API_KEY=replace-with-your-key-locally
AZURE_OPENAI_CHAT_DEPLOYMENT=YOUR-GPT-4.1-MINI-DEPLOYMENT-NAME

# Email - local development uses the Django console backend by default.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@example.invalid
EMAIL_TIMEOUT=10

# Production-only examples. Configure these in the deployment environment,
# not in the committed example file.
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# CSRF_TRUSTED_ORIGINS=https://hr.example.com
